# ---------------------------------------------------------------------------
# SS Group Digital — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://ssgroupdigital.com

# --- Auth / DB (wire up in Phase 2) ---------------------------------------
DATABASE_URL=
AUTH_SECRET=

# --- Spotify (Web API: catalog + audio features. Artist stats need
#     Spotify for Artists, which has NO public API — use S4A CSV export) -----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube Data + Analytics API (Google Cloud OAuth) --------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Meta / Instagram Graph API (Business or Creator accounts only) -------
META_APP_ID=
META_APP_SECRET=

# --- TikTok Display API + Research API ------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Deezer (public API, no key for most endpoints) -----------------------
DEEZER_APP_ID=
DEEZER_SECRET=

# --- Apple Music (MusicKit: private key + team/key IDs -> signed JWT) -----
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
